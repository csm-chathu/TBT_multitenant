{
  "permissions": {
    "allow": [
      "Bash(graphify query *)",
      "Bash(npx ts-node *)",
      "Bash(grep -v \"//\\\\|customSearchFilter\\\\b\")"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/DELL/.local/bin/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/DELL/.local/bin/graphify.EXE hook-guard read"
          }
        ]
      }
    ]
  }
}
