DB_HOST=localhost
DB_NAME=tbt_nestjs
DB_USER=root
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_DIALECT=mysql
DB_LOGGING=false
JWT_SECRET=REPLACE_WITH_JWT_SECRET
API_PREFIX=api/v1
FILESYSTEM_DRIVER=s3
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=REPLACE_WITH_AWS_REGION
AWS_BUCKET=REPLACE_WITH_AWS_BUCKET
AWS_URL=REPLACE_WITH_AWS_URL
S3_BASE_PREFIX=v2

DEFAULT_USER_PASSWORD=REPLACE_WITH_DEFAULT_USER_PASSWORD

#mail
MAIL_SMTP_DOMAIN=mg.elifeamerica.com
MAIL_SMTP_DOMAIN_SECRET=REPLACE_WITH_MAIL_SMTP_SECRET
FROM_EMAIL=REPLACE_WITH_FROM_EMAIL
FROM_NAME=REPLACE_WITH_FROM_NAME
INTERNAL_EMAIL_ADDRESS=REPLACE_WITH_INTERNAL_EMAIL
VERIFY_EMAIL_ADDRESSES=true

CORS_ORIGIN=http://localhost:5173

# Frontend Base URL (for email links)
APP_BASE_URL=http://localhost:5173
# OR use BASE_URL instead
# BASE_URL=http://localhost:5173

# pusher realtime
PUSHER_APP_ID=REPLACE_WITH_PUSHER_APP_ID
PUSHER_KEY=REPLACE_WITH_PUSHER_KEY
PUSHER_SECRET=REPLACE_WITH_PUSHER_SECRET
PUSHER_CLUSTER=REPLACE_WITH_PUSHER_CLUSTER
PUSHER_USE_TLS=true
PUSHER_LOG_TO_CONSOLE=true
PUSHER_DASHBOARD_CHANNEL=private-dashboard
PUSHER_LEGACY_TICKET_CHANNEL=ticket-channel

#sms
#twilio SID & token
#SMS_GATEWAY_ACCESS_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#SMS_GATEWAY_ACCESS_TOKEN=TWILIO_AUTH_TOKEN_PLACEHOLDER
#SMS_FROM_NUMBER=+16262098347

